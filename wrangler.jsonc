{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landingpage",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every request goes through the Worker first: it handles the API, the dashboard/LMS subdomains,
    // www → bare-domain and old /landing/... redirects, then serves the page from ./public.
    "run_worker_first": true
  },
  // The whole site is served by this Worker. Requires thearimatheaacademy.com to use Cloudflare nameservers,
  // and no other A/AAAA/CNAME records on the bare domain or www (see README, "Domain").
  "routes": [
    { "pattern": "thearimatheaacademy.com", "custom_domain": true },
    { "pattern": "www.thearimatheaacademy.com", "custom_domain": true },
    // Admin dashboard. Cloudflare creates the DNS record and certificate automatically.
    { "pattern": "dashboard.thearimatheaacademy.com", "custom_domain": true },
    // Student portal (LMS).
    { "pattern": "lms.thearimatheaacademy.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://thearimatheaacademy.com",
    "DASHBOARD_URL": "https://dashboard.thearimatheaacademy.com/",
    "LMS_URL": "https://lms.thearimatheaacademy.com/",
    "EMAIL_FROM": "The Arimathea Academy <hello@kingdomschool.thearimatheaacademy.com>",
    "EMAIL_REPLY_TO": "info@thearimatheaacademy.com",
    "SUPABASE_URL": "https://gzklxldsmhhwcolsgptk.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_PchCejAC6t5i16kw2Yq9MA_QDqR12LH",
    // Stripe publishable key (pk_test_… while testing, pk_live_… when live). It is public: the payment
    // step of the forms needs it to show Stripe's embedded checkout.
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51TRYWYC8Zn7VQK52NRiA2R84vP4QLczdKYqVuX76axfvoAkLBcsxMMnYASPY8yxJqvpPZcGPfsKHhO1UYStf08eZ00YLnULPCP"
  },
  // ── Preview: a separate Worker, "landingpage-preview", on its free workers.dev address. ──
  // For testing before the domain moves: `npm run preview:deploy`. No custom domains, no cron (it shares the
  // real database, so it must never send the automated emails), and its links point at its own address.
  // Use Stripe TEST keys here. Secrets are separate: `npx wrangler secret put NAME --env preview`.
  "env": {
    "preview": {
      "routes": [],
      "workers_dev": true,
      "triggers": { "crons": [] },
      "vars": {
        "PREVIEW": "true",
        // These three are replaced at runtime with the preview's own address.
        "SITE_URL": "https://preview.invalid",
        "DASHBOARD_URL": "https://preview.invalid/landing/admin/",
        "LMS_URL": "https://preview.invalid/landing/lms/",
        "EMAIL_FROM": "The Arimathea Academy (TEST) <hello@kingdomschool.thearimatheaacademy.com>",
        "EMAIL_REPLY_TO": "info@thearimatheaacademy.com",
        "SUPABASE_URL": "https://gzklxldsmhhwcolsgptk.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_PchCejAC6t5i16kw2Yq9MA_QDqR12LH",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51TRYWYC8Zn7VQK529WNNqgHQJ2vwTQSnsbFUGfkYvcFYYEXFhm5OHS8PKs4Gm0RJEeNzWzLtDEWo5u697qy0DmhS00MvFEwk3R"
      }
    }
  }
  // Secrets (set with `npx wrangler secret put NAME`):
  //   SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY
  //   optional: STRIPE_PRICE_ID (use an existing £150 Price instead of an inline price)
}
